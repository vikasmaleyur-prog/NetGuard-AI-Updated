# NetGuard AI - Backend Environment Configuration Example
# Copy this file to .env and configure values for your environment.

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Database Configuration
# Optional: MongoDB Atlas Connection URI
# If omitted or unreachable, NetGuard AI automatically falls back to local SQLite persistence (database/netguard.db)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# CORS Configuration
# Additional comma-separated origins allowed to make API requests
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Monitoring & Alert Thresholds
COLLECTOR_INTERVAL_SECONDS=5
CPU_WARNING_THRESHOLD=80.0
CPU_CRITICAL_THRESHOLD=95.0
MEMORY_WARNING_THRESHOLD=85.0
LATENCY_WARNING_THRESHOLD_MS=100.0
